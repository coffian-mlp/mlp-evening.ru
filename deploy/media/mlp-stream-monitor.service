[Unit]
Description=MLP stream health supervision
After=network-online.target mysql.service mlp-mediamtx.service

[Service]
Type=simple
User=fastuser
Group=fastuser
WorkingDirectory=/var/www/fastuser/data/www/mlp-evening.ru
ExecStart=/usr/bin/php stream_monitor_worker.php --loop
Restart=always
RestartSec=5
MemoryMax=128M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
